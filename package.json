{
  "name": "plana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @plana/demo dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @plana/demo build",
    "preview": "pnpm --filter @plana/demo preview",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
