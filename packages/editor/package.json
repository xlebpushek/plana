{
  "name": "@plana/editor",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external three --external @plana/core --external @plana/renderer --external @plana/viewer --external lucide-react",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --config vite.config.ts",
    "preview:build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@plana/core": "workspace:*",
    "@plana/viewer": "workspace:*",
    "lucide-react": "^1.46.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
